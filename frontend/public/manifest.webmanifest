{
  "name": "TruthLens AI",
  "short_name": "TruthLens",
  "description": "Check how credible a news article is. Paste a link or text and get an explainable score.",
  "start_url": "/user/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F6F7FC",
  "theme_color": "#4F46E5",
  "categories": ["news", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Analyze an article", "short_name": "Analyze", "url": "/user/analyze", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "History", "short_name": "History", "url": "/user/history", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": { "action": "/user/analyze", "method": "GET", "params": { "title": "title", "text": "text", "url": "url" } }
}
