NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/newsguard_ai
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional. Leave empty to use the built-in in-memory cache fallback.
REDIS_URL=
# Optional: Google Fact Check Tools API key (shows published fact-checks per claim)
FACTCHECK_API_KEY=
SERPER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GOOGLE_ADMIN_EMAIL=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=NewsGuard AI <noreply@newsguard.local>
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
ADMIN_NAME=Administrator
ADMIN_EMAIL=replace_with_admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_unique_password
