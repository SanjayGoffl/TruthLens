{
  "manifest_version": 3,
  "name": "TruthLens AI",
  "version": "0.1.0",
  "description": "Send the current article or selected text to TruthLens AI for a credibility report.",
  "permissions": ["activeTab", "contextMenus", "storage", "scripting"],
  "action": { "default_title": "Check with TruthLens AI", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" }
}
